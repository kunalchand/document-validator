# Application Settings
APP_NAME=Document Validator
APP_ENV=production
LOG_LEVEL=INFO

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Supported values: dummy | anthropic | grok | ollama
LLM_PROVIDER=dummy

# Anthropic (Claude) — set LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001   # or claude-sonnet-4-6 / claude-opus-4-7

# Grok (xAI) — set LLM_PROVIDER=grok
# LLM_API_KEY=xai-...
# LLM_MODEL=grok-3-mini                 # or grok-3 / grok-2

# Ollama (local) — set LLM_PROVIDER=ollama
# LLM_API_KEY=                          # not required for Ollama
# LLM_MODEL=llama3.2                    # any model pulled via `ollama pull <model>`
# OLLAMA_HOST=http://localhost:11434    # override if Ollama runs on a different host/port

LLM_API_KEY=
LLM_MODEL=dummy-model
OLLAMA_HOST=http://localhost:11434

# ── Embedding Provider ─────────────────────────────────────────────────────────
# Only dummy is available in Phase 1; concrete providers added in Phase 2
EMBEDDING_PROVIDER=dummy
EMBEDDING_API_KEY=
EMBEDDING_MODEL=dummy-embedding

# ── File Upload Limits ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_TEXT_LENGTH=50000
MAX_RULES=100

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
