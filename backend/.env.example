# Application Settings
APP_NAME=Document Validator
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_TEXT_LENGTH=50000
MAX_RULES=100

# CORS Settings
CORS_ORIGINS=["http://localhost:3000"]
