# Application Settings
APP_NAME=Document Validator
APP_ENV=production
LOG_LEVEL=INFO

# LLM Provider Configuration (Generic/Abstract - supports: dummy, openai, anthropic, google, grok)
LLM_PROVIDER=dummy
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=dummy-model

# Embedding Provider Configuration (Generic/Abstract - supports: dummy, openai, google, etc.)
EMBEDDING_PROVIDER=dummy
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=dummy-embedding

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_TEXT_LENGTH=50000
MAX_RULES=100

# CORS Settings
CORS_ORIGINS=["http://localhost:3000"]
